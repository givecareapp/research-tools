{
  "schema_version": "givecare.module/v2",
  "repository": "assessment",
  "owns": "GiveCare Tools: public TypeScript packages for caregiver assessment (GC-SDOH)",
  "check": "npm run check",
  "produces": [
    {
      "id": "@givecare/tools.InstrumentExport",
      "path": "data/instruments-export.json",
      "for": [
        "care-evals",
        "mira"
      ]
    },
    {
      "id": "@givecare/tools",
      "path": "src",
      "package": "@givecare/tools",
      "for": [
        "mira"
      ]
    }
  ],
  "consumes": []
}
