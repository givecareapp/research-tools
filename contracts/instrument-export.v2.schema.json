{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/givecareapp/assessment/contracts/instrument-export.v2.schema.json",
  "title": "@givecare/tools.InstrumentExport/v2",
  "description": "The one verified instrument definition, projected to mira, invisiblebench and the web assessment. v2 adds per-instrument version and license so every measurement binds to the exact instrument that produced it, and so licensed instruments are labelled rather than copied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner_revision", "instruments", "domainWeights", "domainLabels"],
  "properties": {
    "schema_version": {"const": "@givecare/tools.InstrumentExport/v2"},
    "owner_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "note": {"type": "string"},
    "instruments": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/instrument"}
    },
    "domainWeights": {"type": "object", "additionalProperties": {"type": "number"}},
    "domainLabels": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "license", "items"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "license": {
          "description": "MIT for GiveCare's own instruments. A third-party instrument appears only with a redistribution decision; until then it is absent, never inlined.",
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx_or_terms", "redistributable"],
          "properties": {
            "spdx_or_terms": {"type": "string", "minLength": 1},
            "redistributable": {"type": "boolean"},
            "source": {"type": "string"}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "prompt"],
            "properties": {"id": {"type": "string"}, "prompt": {"type": "string"}, "gcDomain": {"type": "string"}}
          }
        }
      }
    }
  }
}
